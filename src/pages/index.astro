---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Content from '../components/Content.astro';
---

<html lang="es" class="h-full">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<link rel="icon" type="image/svg+xml" href="/../../src/media/images/Logo-Zentriq.png" />
		<link rel="icon" href="../../src/media/images/Logo-Zentriq.png" />
		<link rel="apple-touch-icon" href="../../src/media/images/Logo-Zentriq.png" />

		<title>Zentriq</title>

		<meta name="description" content="Zentriq es una empresa de desarrollo de software que se especializa en la creación de soluciones digitales innovadoras y personalizadas para sus clientes. Con un enfoque centrado en la calidad, la eficiencia y la satisfacción del cliente, Zentriq ofrece una amplia gama de servicios que incluyen el desarrollo de sitios web, apps wes y móviles, así como consultoría tecnológica y soporte continuo." />
		<meta name="author" content="Zentriq" />
		<meta name="keywords" content="Zentriq, desarrollo web, desarrollo de software, soluciones digitales, sitios web, apps web, apps móviles, consultoría tecnológica, soporte continuo" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href="https://www.zentriqweb.com" />

		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://www.zentriqweb.com" />
		<meta property="og:title" content="Zentriq - Empresa de desarrollo Web" />
		<meta property="og:description" content="Zentriq es una empresa de desarrollo de software que se especializa en la creación de soluciones digitales innovadoras y personalizadas para sus clientes. Con un enfoque centrado en la calidad, la eficiencia y la satisfacción del cliente, Zentriq ofrece una amplia gama de servicios que incluyen el desarrollo de sitios web, apps wes y móviles, así como consultoría tecnológica y soporte continuo." />
		<meta property="og:image" content="https://www.zentriqweb.com/Full-Icon.png" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="Zentriq" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content="https://www.zentriqweb.com" />
		<meta name="twitter:title" content="Zentriq - Empresa de desarrollo Web" />
		<meta name="twitter:description" content="Zentriq es una empresa de desarrollo de software que se especializa en la creación de soluciones digitales innovadoras y personalizadas para sus clientes. Con un enfoque centrado en la calidad, la eficiencia y la satisfacción del cliente, Zentriq ofrece una amplia gama de servicios que incluyen el desarrollo de sitios web, apps wes y móviles, así como consultoría tecnológica y soporte continuo." />
		<meta name="twitter:image" content="https://www.zentriqweb.com/Full-Icon.png" />
		<meta name="twitter:image:alt" content="Zentriq" />
		<meta name="twitter:site" content="@zentriqweb" />
		<meta name="twitter:creator" content="@zentriqweb" />
		<meta name="twitter:domain" content="zentriqweb.com" />

		<meta name="theme-color" content="#2563EB" />
	</head>
	<body class="flex flex-col h-full relative">
		<Header />
		<Content />
	</body>
</html>
