---
const phone = '573182848957';
---

<section id="contact" class="relative w-full bg-(--secondary-color)">
    <div class="absolute inset-0 hero-dot-grid pointer-events-none opacity-30"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 py-16 flex flex-col lg:flex-row gap-14 items-start">
        <div class="flex flex-col gap-8 lg:sticky lg:top-24 lg:w-80 shrink-0">
            <div class="flex flex-col gap-4">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-(--accent-color)/20 bg-(--accent-color)/5 text-(--accent-color) text-xs font-medium tracking-widest uppercase w-fit">
                    <span class="w-1.5 h-1.5 rounded-full bg-(--accent-color) animate-pulse"></span>
                    Contacto
                </div>
                <h2 class="text-3xl sm:text-4xl font-bold text-(--surface-color) tracking-tight leading-tight">
                    Cuéntanos tu <span class="hero-accent-text">proyecto.</span>
                </h2>
                <p class="text-sm text-(--surface-color)/50 leading-relaxed">
                    Completa el formulario y te contactamos por WhatsApp para agendar una reunión sin costo.
                </p>
            </div>
            <div class="flex flex-col gap-4">
                <div class="flex items-start gap-3">
                    <div class="w-9 h-9 rounded-xl bg-(--primary-color)/10 border border-(--primary-color)/20 flex items-center justify-center shrink-0">
                        <svg class="w-4 h-4 text-(--accent-color)" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-(--surface-color)">Respuesta rápida</p>
                        <p class="text-xs text-(--surface-color)/45">Te respondemos en menos de 24 horas</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="w-9 h-9 rounded-xl bg-(--primary-color)/10 border border-(--primary-color)/20 flex items-center justify-center shrink-0">
                        <svg class="w-4 h-4 text-(--accent-color)" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-(--surface-color)">Virtual o presencial</p>
                        <p class="text-xs text-(--surface-color)/45">Nos adaptamos a tu disponibilidad</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="w-9 h-9 rounded-xl bg-(--primary-color)/10 border border-(--primary-color)/20 flex items-center justify-center shrink-0">
                        <svg class="w-4 h-4 text-(--accent-color)" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-(--surface-color)">Sin compromiso</p>
                        <p class="text-xs text-(--surface-color)/45">Primera reunión de diagnóstico gratuita</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="flex-1 w-full">
            <form id="contact-form" class="flex flex-col gap-5 bg-(--bg-card-color) border border-(--border-color) rounded-2xl p-8" novalidate>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div class="flex flex-col gap-1.5">
                        <label for="nombre" class="text-xs font-medium text-(--surface-color)/60 uppercase tracking-wider">Nombre</label>
                        <input id="nombre" name="nombre" type="text" placeholder="Tu nombre completo" required class="contact-input"/>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label for="emprendimiento" class="text-xs font-medium text-(--surface-color)/60 uppercase tracking-wider">Emprendimiento</label>
                        <input id="emprendimiento" name="emprendimiento" type="text" placeholder="Nombre de tu negocio o proyecto" required class="contact-input"/>
                    </div>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label for="tipo" class="text-xs font-medium text-(--surface-color)/60 uppercase tracking-wider">Tipo de proyecto</label>
                    <div class="relative">
                        <select id="tipo" name="tipo" required class="contact-input appearance-none pr-10 cursor-pointer">
                            <option value="" disabled selected>Selecciona una opción</option>
                            <option value="Página web">Página web</option>
                            <option value="Sitio web">Sitio web</option>
                            <option value="Aplicación web">Aplicación web</option>
                            <option value="Tienda en línea">Tienda en línea</option>
                            <option value="Automatización">Automatización</option>
                            <option value="Otro">Otro</option>
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center">
                            <svg class="w-4 h-4 text-(--surface-color)/40" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                            </svg>
                        </div>
                    </div>
                </div>
                <div class="flex flex-col gap-2">
                    <span class="text-xs font-medium text-(--surface-color)/60 uppercase tracking-wider">Disponibilidad para reunión</span>
                    <div class="flex gap-3">
                        <label class="availability-option">
                            <input type="radio" name="disponibilidad" value="Virtual" class="sr-only" required />
                            <div class="availability-btn">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25"/>
                                </svg>
                                Virtual
                            </div>
                        </label>
                        <label class="availability-option">
                            <input type="radio" name="disponibilidad" value="Presencial" class="sr-only" />
                            <div class="availability-btn">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/>
                                </svg>
                                Presencial
                            </div>
                        </label>
                        <label class="availability-option">
                            <input type="radio" name="disponibilidad" value="Ambas opciones" class="sr-only" />
                            <div class="availability-btn">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"/>
                                </svg>
                                Ambas
                            </div>
                        </label>
                    </div>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label for="descripcion" class="text-xs font-medium text-(--surface-color)/60 uppercase tracking-wider">Descripción del proyecto</label>
                    <textarea id="descripcion" name="descripcion" rows="4" placeholder="Cuéntanos qué quieres construir, qué problema resuelve y cualquier detalle relevante..." required class="contact-input resize-none"></textarea>
                </div>
                <p id="form-error" class="hidden text-xs text-red-400 bg-red-500/8 border border-red-500/20 rounded-xl px-4 py-3">
                    Por favor completa todos los campos antes de continuar.
                </p>
                <button type="submit" class="mt-1 inline-flex items-center justify-center gap-2.5 px-6 py-3 rounded-full bg-(--primary-color) text-(--surface-color) text-sm font-semibold hover:bg-(--primary-color-hover) transition-all duration-200 shadow-neon cursor-pointer">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
                    </svg>
                    Enviar por WhatsApp
                </button>
            </form>
        </div>
    </div>
</section>

<style>
    .contact-input {
        width: 100%;
        background-color: var(--secondary-color);
        border: 1px solid var(--border-color);
        border-radius: 0.75rem;
        padding: 0.625rem 0.875rem;
        font-size: 0.875rem;
        color: var(--surface-color);
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .contact-input::placeholder {
        color: color-mix(in srgb, var(--surface-color) 30%, transparent);
    }
    .contact-input:focus {
        border-color: color-mix(in srgb, var(--primary-color) 60%, transparent);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary-color) 12%, transparent);
    }
    .contact-input option {
        background-color: var(--secondary-color);
        color: var(--surface-color);
    }

    .availability-option { display: contents; }
    .availability-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 9999px;
        border: 1px solid var(--border-color);
        background-color: var(--bg-card-color);
        color: color-mix(in srgb, var(--surface-color) 50%, transparent);
        font-size: 0.8125rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        user-select: none;
    }
    .availability-btn:hover {
        border-color: color-mix(in srgb, var(--accent-color) 30%, transparent);
        color: var(--surface-color);
    }
    input[type="radio"]:checked + .availability-btn {
        border-color: color-mix(in srgb, var(--primary-color) 60%, transparent);
        background-color: color-mix(in srgb, var(--primary-color) 12%, transparent);
        color: var(--surface-color);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary-color) 10%, transparent);
    }
</style>

<script define:vars={{ phone }}>
    const form = document.getElementById('contact-form');
    const errorMsg = document.getElementById('form-error');

    form.addEventListener('submit', (e) => {
        e.preventDefault();

        const nombre       = form.nombre.value.trim();
        const emprendimiento = form.emprendimiento.value.trim();
        const tipo         = form.tipo.value;
        const disponibilidad = form.disponibilidad.value;
        const descripcion  = form.descripcion.value.trim();

        if (!nombre || !emprendimiento || !tipo || !disponibilidad || !descripcion) {
            errorMsg.classList.remove('hidden');
            return;
        }
        errorMsg.classList.add('hidden');

        const mensaje =
`¡Hola! Quiero agendar una reunión para hablar sobre mi proyecto.

*Nombre:* ${nombre}
*Emprendimiento:* ${emprendimiento}
*Tipo de proyecto:* ${tipo}
*Disponibilidad:* ${disponibilidad}

*Descripción:*
${descripcion}`;

        const url = `https://wa.me/${phone}?text=${encodeURIComponent(mensaje)}`;
        window.open(url, '_blank', 'noopener,noreferrer');
    });
</script>
