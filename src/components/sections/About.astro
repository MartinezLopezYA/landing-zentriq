---
const cards = [
    {
        title: 'Quiénes somos',
        body: 'Un equipo apasionado por la tecnología y el diseño, dedicado a crear soluciones digitales que conectan personas y transforman ideas en realidades.',
        icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"/>`,
    },
    {
        title: '¿Por qué elegirnos?',
        body: 'Nos destacamos por la innovación, el diseño centrado en el usuario y resultados medibles. Cada proyecto es una oportunidad de generar impacto real.',
        icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z"/>`,
    },
    {
        title: 'Nuestra misión',
        body: 'Crear soluciones digitales innovadoras que conecten personas, optimicen procesos y transformen ideas en impacto tecnológico real para nuestros clientes.',
        icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.631 8.41m5.96 5.96a14.926 14.926 0 0 1-5.841 2.58m-.119-8.54a6 6 0 0 0-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 0 0-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 0 1-2.448-2.448 14.9 14.9 0 0 1 .06-.312m-2.24 2.39a4.493 4.493 0 0 0-1.757 4.306 4.493 4.493 0 0 0 4.306-1.758M16.5 9a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z"/>`,
    },
];

const stack = ['Figma', 'Tailwind CSS', 'Astro', 'Next Js', 'React', 'Angular', 'React Native', 'TypeScript', 'Node.js', 'Nest js', 'PostgreSQL'];
---

<section id="about" class="relative w-full h-auto min-h-100 md:min-h-120 lg:min-h-160 bg-(--secondary-color-hover)">
    <div class="absolute inset-0 hero-dot-grid pointer-events-none opacity-50"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 py-10 flex flex-col items-center gap-14">
        <div class="flex flex-col items-center text-center gap-4 max-w-lg">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-(--accent-color)/20 bg-(--accent-color)/5 text-(--accent-color) text-xs font-medium tracking-widest uppercase">
                Sobre nosotros
            </div>
            <h2 class="text-3xl sm:text-4xl font-bold text-(--surface-color) tracking-tight leading-tight">
                Tecnología que <span class="hero-accent-text">conecta.</span>
            </h2>
            <p class="text-sm sm:text-base text-(--surface-color)/50 leading-relaxed">
                Creamos soluciones digitales modernas con foco en diseño, rendimiento e impacto real para el negocio.
            </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 w-full">
            {cards.map(card => (
                <div class="flex flex-col gap-5 bg-(--bg-card-color) border border-(--border-color) rounded-2xl p-7 hover:bg-(--bg-card-color-hover) hover:border-(--accent-color)/15 transition-all duration-300">
                    <div class="w-11 h-11 rounded-xl bg-(--primary-color)/10 border border-(--primary-color)/20 flex items-center justify-center text-(--accent-color) shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5" set:html={card.icon}></svg>
                    </div>
                    <div class="flex flex-col gap-2">
                        <h3 class="text-base font-semibold text-(--surface-color)">{card.title}</h3>
                        <p class="text-sm text-(--surface-color)/50 leading-relaxed">{card.body}</p>
                    </div>
                </div>
            ))}
        </div>
        <div class="flex flex-col items-center gap-4 w-full pt-2 border-t border-(--border-color)">
            <span class="text-xs text-(--surface-color)/30 tracking-widest uppercase">Stack tecnológico</span>
            <div class="flex flex-wrap items-center justify-center gap-2">
                {stack.map(tech => (
                    <span class="px-3 py-1 rounded-full text-xs font-medium border border-(--border-color) text-(--surface-color)/45 bg-(--bg-card-color) hover:border-(--accent-color)/20 hover:text-(--surface-color)/70 transition-all duration-200 cursor-default">
                        {tech}
                    </span>
                ))}
            </div>
        </div>
    </div>
</section>
