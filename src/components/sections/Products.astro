    premium:    'border-violet-500/30 bg-violet-500/8 text-violet-400',
    default:    'border-(--border-color) bg-(--bg-card-color) text-(--surface-color)/60',
    beta:       'border-amber-500/30 bg-amber-500/8 text-amber-400',
